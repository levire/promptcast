{
  "extraKnownMarketplaces": {
    "promptcast": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "swift-lsp@promptcast": true
  },
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make e2e)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make check)",
      "Bash(make app)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift format:*)",
      "Bash(swiftlint:*)",
      "Bash(.build/debug/PromptCast --package:*)",
      "Bash(scripts/e2e.sh:*)",
      "Bash(/usr/bin/log show:*)",
      "Bash(periphery scan:*)",
      "Bash(gitleaks:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/comment-reminder.py\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
