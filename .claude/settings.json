{
  "permissions": {
    "allow": [
      "Bash(make build)", "Bash(make test)", "Bash(make e2e)", "Bash(make lint)",
      "Bash(make format)", "Bash(make check)", "Bash(make app)",
      "Bash(swift build:*)", "Bash(swift test:*)", "Bash(swift format:*)", "Bash(swiftlint:*)",
      "Bash(.build/debug/ScreenInk --package:*)", "Bash(scripts/e2e.sh:*)",
      "Bash(/usr/bin/log show:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh", "timeout": 600 }]
      }
    ]
  }
}
